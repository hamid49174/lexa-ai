# Lexa AI environment variables
#
# Copy this file to .env for local development.
# Prefer Windows Credential Manager via python-keyring for real secrets:
#
#   python -c "import keyring; keyring.set_password('lexa-ai', 'groq_api_key', 'YOUR_KEY')"
#
# Never commit real API keys.

# AI providers
# GROQ_API_KEY=your_groq_key
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key
# OLLAMA_URL=http://127.0.0.1:11434

# Web-Suche (optional) — fuer Recherche auf Perplexity-Niveau. Ohne Key: DuckDuckGo-Fallback.
# LEXA_SEARCH_PROVIDER=auto   # auto | tavily | brave | exa
# TAVILY_API_KEY=your_tavily_key   # empfohlen (Gratis-Tier ~1000 Suchen/Monat), tavily.com
# BRAVE_API_KEY=your_brave_search_key
# EXA_API_KEY=your_exa_key

# Voice providers
# DEEPGRAM_API_KEY=your_deepgram_key
# CARTESIA_API_KEY=your_cartesia_key
# ELEVENLABS_API_KEY=your_elevenlabs_key

# Wake word
# LEXA_WAKE_ENGINE=openwakeword
# LEXA_OPENWAKEWORD_MODELS=alexa
# LEXA_OPENWAKEWORD_THRESHOLD=0.55
# LEXA_OPENWAKEWORD_PATIENCE=2
# Optional commercial/custom-keyword engine:
# LEXA_WAKE_ENGINE=porcupine
# LEXA_PORCUPINE_ACCESS_KEY=your_picovoice_key
# LEXA_PORCUPINE_KEYWORD_PATHS=C:\path\to\lexa.ppn

# Communication providers
# OPENWEATHERMAP_API_KEY=your_openweathermap_key
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
# DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# LEXA_ENV=development

# Payments
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# STRIPE_ALLOWED_PRICE_IDS=price_pro_monthly,price_pro_yearly,price_ultra_monthly,price_ultra_yearly
# LEXA_ALLOWED_CHECKOUT_ORIGINS=https://exa-ai.space

# Supabase SaaS backend integration
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_public_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_never_commit

# Backend
# LEXA_PORT=8000

# Release proof smokes
# LEXA_LICENSE_SMOKE_API_URL=http://127.0.0.1:8000
# LEXA_LICENSE_SMOKE_KEY=LEXA-00000-00000-00000-00000
# LEXA_LICENSE_SMOKE_EXPECTED_PLAN=pro
