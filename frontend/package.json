{
  "name": "lexa-ai",
  "version": "1.0.0",
  "description": "Lexa AI — Lokaler KI-Desktop-Assistent für Windows",
  "main": "main.js",
  "scripts": {
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "dev": "set \"ELECTRON_RUN_AS_NODE=\" && electron . --dev",
    "build": "set \"ELECTRON_RUN_AS_NODE=\" && electron-builder --config electron-builder.json"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.0.0"
  },
  "author": "alexsprogis",
  "license": "MIT"
}
